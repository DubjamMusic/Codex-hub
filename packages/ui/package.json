{
  "name": "@hustlecodex/ui",
  "version": "0.1.0",
  "description": "React UI components for the HustleCodeX ecosystem",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "require": "./dist/components/*.js",
      "import": "./dist/components/*.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "hustlecodex"
  ],
  "license": "MIT"
}
